# 이 파일을 .env로 복사해 값을 바꿉니다.
#   cp .env.example .env
# .env는 git에 올리지 않습니다. 이 파일에는 이름과 자리표시 값만 둡니다.

COMPOSE_PROJECT_NAME=cdclake

# 원천 PostgreSQL
POSTGRES_DB=source_db
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Debezium이 쓰는 복제 전용 계정 (최초 기동 때 infra/postgres/init에서 만듭니다)
CDC_USER=cdc_reader
CDC_PASSWORD=change-me-too

# 호스트 포트. 다른 프로그램과 겹치면 바꿉니다.
POSTGRES_PORT=5432
KAFKA_HOST_PORT=29092
CONNECT_PORT=18083
KAFKA_UI_PORT=18080

# 시세와 지표 적재(각자 발급, data/README.md 참고)
MASSIVE_API_KEY=
ECOS_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# 관심도 적재(loaders/README.md)
# 위키백과 조회수 API의 User-Agent에 넣을 연락처. 공개 저장소에 적어도 되는 메일 주소나 웹 주소
WIKIMEDIA_CONTACT=
# 네이버 데이터랩. 비워 두면 그 적재기는 건너뜀
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 레이크(lake, flink, spark profile). docs/decisions/0002
# Iceberg JDBC 카탈로그가 쓰는 PostgreSQL(원천 DB와 따로 띄움)
CATALOG_DB=iceberg_catalog
CATALOG_USER=iceberg
CATALOG_PASSWORD=change-me-catalog
# S3 호환 저장소(MinIO 계열). 비밀 키는 8자 이상
S3_ACCESS_KEY=lake-admin
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET=warehouse
# Flink checkpoint 주기. Bronze는 checkpoint 때 commit됩니다
CHECKPOINT_INTERVAL=10s
S3_PORT=19000
S3_CONSOLE_PORT=19001
FLINK_UI_PORT=18081
SPARK_UI_PORT=14040
SPARK_THRIFT_PORT=10000
AIRFLOW_PORT=18082
