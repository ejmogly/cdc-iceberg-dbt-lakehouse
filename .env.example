# 이 파일을 .env로 복사해 값을 바꿉니다.
#   cp .env.example .env
# .env는 git에 올리지 않습니다. 이 파일에는 이름과 자리표시 값만 둡니다.

COMPOSE_PROJECT_NAME=cdclake

# 원천 PostgreSQL
POSTGRES_DB=source_db
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Debezium이 쓰는 복제 전용 계정 (최초 기동 때 infra/postgres/init에서 만듭니다)
CDC_USER=cdc_reader
CDC_PASSWORD=change-me-too

# 호스트 포트. 다른 프로그램과 겹치면 바꿉니다.
POSTGRES_PORT=5432
KAFKA_HOST_PORT=29092
CONNECT_PORT=18083
KAFKA_UI_PORT=18080

# 시세와 지표 적재(각자 발급, data/README.md 참고)
MASSIVE_API_KEY=
ECOS_API_KEY=
DATA_GO_KR_SERVICE_KEY=
